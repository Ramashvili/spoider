{
 "version": 1,
 "spacing": -1,
 "layout": "spider",
 "colours": "family",
 "marks": [
  "⭐",
  "❓",
  "✅",
  "⚠️"
 ],
 "justify": 66,
 "cut": [],
 "root": {
  "id": "m001",
  "text": "spoider",
  "collapsed": false,
  "mark": "",
  "children": [
   {
    "id": "m002",
    "text": "a mind map in a terminal",
    "collapsed": false,
    "mark": "⭐",
    "children": [
     {
      "id": "m900",
      "text": "planning, notes, decisions",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m003",
      "text": "every colour is your terminal's",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m004",
      "text": "the map is a JSON file",
      "collapsed": false,
      "mark": "",
      "children": [
       {
        "id": "m005",
        "text": "read it",
        "collapsed": false,
        "mark": "",
        "children": []
       },
       {
        "id": "m006",
        "text": "diff it",
        "collapsed": false,
        "mark": "",
        "children": []
       },
       {
        "id": "m007",
        "text": "keep it in git",
        "collapsed": false,
        "mark": "",
        "children": []
       }
      ]
     }
    ]
   },
   {
    "id": "m008",
    "text": "making cells",
    "collapsed": false,
    "mark": "",
    "children": [
     {
      "id": "m009",
      "text": "tab makes a child",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m010",
      "text": "return makes a sibling",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m011",
      "text": "e renames where it stands",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m012",
      "text": "shift+return starts a line",
      "collapsed": false,
      "mark": "",
      "children": []
     }
    ]
   },
   {
    "id": "m800",
    "text": "the arrows move around",
    "collapsed": false,
    "mark": "",
    "children": []
   },
   {
    "id": "m019",
    "text": "the cut stack",
    "collapsed": false,
    "mark": "",
    "children": [
     {
      "id": "m020",
      "text": "^K cuts a branch onto the stack",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m021",
      "text": "^U pastes the newest cut",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m022",
      "text": "p shows the stack beside the map",
      "collapsed": false,
      "mark": "",
      "children": [
       {
        "id": "m023",
        "text": "cuts wait newest first",
        "collapsed": false,
        "mark": "",
        "children": []
       },
       {
        "id": "m024",
        "text": "you can work inside the panel",
        "collapsed": false,
        "mark": "",
        "children": []
       }
      ]
     }
    ]
   },
   {
    "id": "m025",
    "text": "shape and air",
    "collapsed": false,
    "mark": "",
    "children": [
     {
      "id": "m026",
      "text": "^L cycles four shapes",
      "collapsed": false,
      "mark": "",
      "children": [
       {
        "id": "m027",
        "text": "spider",
        "collapsed": false,
        "mark": "",
        "children": []
       },
       {
        "id": "m028",
        "text": "pyramid",
        "collapsed": false,
        "mark": "",
        "children": []
       },
       {
        "id": "m029",
        "text": "bush",
        "collapsed": false,
        "mark": "",
        "children": []
       },
       {
        "id": "m030",
        "text": "branch",
        "collapsed": false,
        "mark": "",
        "children": []
       }
      ]
     },
     {
      "id": "m031",
      "text": "c colours by family or by depth",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m032",
      "text": "= opens the air, - tightens it",
      "collapsed": false,
      "mark": "",
      "children": [
       {
        "id": "m033",
        "text": "- twice drops the walls",
        "collapsed": false,
        "mark": "",
        "children": []
       },
       {
        "id": "m034",
        "text": "then only the cursor is reversed",
        "collapsed": false,
        "mark": "",
        "children": []
       }
      ]
     }
    ]
   },
   {
    "id": "m035",
    "text": "marks and folds",
    "collapsed": false,
    "mark": "",
    "children": [
     {
      "id": "m036",
      "text": "w cycles a cell's mark",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m037",
      "text": "^W chooses the marks this map uses",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m038",
      "text": "t folds a branch away",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m039",
      "text": "the grey +3 counts what is hidden",
      "collapsed": false,
      "mark": "",
      "children": []
     }
    ]
   },
   {
    "id": "m040",
    "text": "writing and finding",
    "collapsed": false,
    "mark": "",
    "children": [
     {
      "id": "m041",
      "text": "^J justifies a paragraph to a width",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m042",
      "text": "^F searches the whole map",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m043",
      "text": "esc and ^C always get you out",
      "collapsed": false,
      "mark": "",
      "children": []
     }
    ]
   },
   {
    "id": "m044",
    "text": "saving",
    "collapsed": false,
    "mark": "",
    "children": [
     {
      "id": "m045",
      "text": "^S saves over the file",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m046",
      "text": "^O writes a copy somewhere else",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m047",
      "text": "^X asks before throwing edits away",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m048",
      "text": "the file looks the same on any machine",
      "collapsed": false,
      "mark": "",
      "children": []
     }
    ]
   },
   {
    "id": "m049",
    "text": "when you forget",
    "collapsed": false,
    "mark": "",
    "children": [
     {
      "id": "m050",
      "text": "^/ lists every key",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m051",
      "text": "^, opens the settings file",
      "collapsed": false,
      "mark": "",
      "children": []
     },
     {
      "id": "m801",
      "text": "every chord can be changed in the config",
      "collapsed": false,
      "mark": "",
      "children": [
       {
        "id": "m802",
        "text": "~/.config/spoider/spoider.conf",
        "collapsed": false,
        "mark": "",
        "children": []
       }
      ]
     }
    ]
   }
  ]
 }
}
