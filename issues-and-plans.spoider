      },
      {
        "id": "0756737968d6",
        "text": "UI improvement",
        "collapsed": false,
        "mark": null,
        "children": [
          {
            "id": "1fb7934a9531",
            "text": "footer could be 2 lines maximum",
            "collapsed": false,
            "mark": "❓",
            "children": []
          },
          {
            "id": "a720169c9876",
            "text": "cell edit highlight",
            "collapsed": false,
