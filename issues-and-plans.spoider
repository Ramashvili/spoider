  "justify": 50,
  "cursor": "12a106e7c43e",
  "root": {
    "id": "08048bdbb41d",
    "text": "spoider development",
    "collapsed": false,
    "mark": null,
    "children": [
      {
        "id": "0756737968d6",
        "text": "improve UI",
        "collapsed": false,
        "mark": null,
        "children": [
          {
            "id": "aca0b7de39d5",
            "text": "resolve dependabot's pull request to allow new version of textual",
            "collapsed": false,
            "mark": null,
            "children": []
          }
        ]
      },
      {
        "id": "12a106e7c43e",
        "text": "README",
        "collapsed": false,
        "mark": null,
        "children": [
          {
            "id": "7a902a791464",
            "text": "mention the specifying font embeds it in svg.\nElse there is a risk that it will not be\ndrawn nicely",
            "collapsed": false,
            "mark": null,
            "children": []
          }
        ]
      },
      {
        "id": "e58cc8120b6d",
        "text": "fix bugs",
        "collapsed": false,
        "mark": null,
        "children": [
          {
            "id": "6595b551ac7b",
            "text": "check if we are rendering svgs in such a way, that\ntext of some lines gets centered on the cell - it\nshould not. There seems do be a discrepancy. We\nwant the text aligned to the left of a cell - fill\nthe rest with empty spaces if necessary. Glyph\ngrid shall reflect the original",
            "collapsed": false,
            "mark": null,
            "children": [
              {
                "id": "7c21e36aa250",
                "text": "this is only aparent in some svg viewers",
                "collapsed": false,
                "mark": null,
                "children": []
              }
            ]
          },
          {
            "id": "a72f659b6e4e",
            "text": "app opened from desktop launcher\nautomatically saves files directly to home\nfolder without saying it",
            "collapsed": true,
            "mark": "❓",
            "children": [
              {
                "id": "3118ae02735e",
                "text": "some minimal file manager-like function for\nthose who launch it as an app from desktop\nlauncher",
                "collapsed": false,
                "mark": "❌",
                "children": []
              },
              {
                "id": "f3b3a36e2071",
                "text": "or make it spawn systems file browser",
                "collapsed": false,
                "mark": "❌",
                "children": []
              },
              {
                "id": "9b55dd70956b",
                "text": "or just have the full path prefilled in save prompt",
                "collapsed": false,
                "mark": "❓",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "id": "f5103208ce96",
        "text": "add features",
        "collapsed": false,
        "mark": null,
        "children": [
          {
            "id": "0b5865bb809a",
            "text": "export as characters",
            "collapsed": true,
            "mark": null,
            "children": [
              {
                "id": "91bb9e91bef0",
                "text": "rich",
                "collapsed": false,
                "mark": null,
                "children": []
              },
              {
                "id": "9733986f8272",
                "text": "ascii",
                "collapsed": false,
                "mark": null,
                "children": []
              }
            ]
          },
          {
            "id": "8cd6f26420fe",
            "text": "implement export options into UI",
            "collapsed": false,
            "mark": null,
            "children": []
          },
          {
            "id": "7b2d92fa3776",
            "text": "ability to have links in cells",
            "collapsed": true,
            "mark": null,
            "children": [
              {
                "id": "b5da18e44484",
                "text": "to files and even websites",
                "collapsed": false,
                "mark": null,
                "children": []
              },
              {
                "id": "c2f2b7433369",
                "text": "syntax same as in markdown",
                "collapsed": false,
                "mark": null,
                "children": []
              },
              {
                "id": "430ad524544e",
                "text": "this would open a new instance",
                "collapsed": false,
                "mark": null,
                "children": [
                  {
                    "id": "7d1c6da2fe94",
                    "text": "ideally on kitty tab, or a new termianl\nwindow, or whatever else is needed",
                    "collapsed": false,
                    "mark": null,
                    "children": []
                  },
                  {
                    "id": "6ed906580032",
                    "text": "I do not want to make tabs in spoider when that\nfunction can be done by kitty or window manager",
                    "collapsed": false,
                    "mark": null,
                    "children": []
                  }
                ]
              }
            ]
          },
          {
            "id": "0d9f355649a8",
            "text": "bring back mouse support",
            "collapsed": false,
            "mark": null,
            "children": []
          },
          {
            "id": "28bd4c40fe32",
            "text": "allow to pipe svgs into other linux commands",
            "collapsed": false,
            "mark": null,
            "children": [
              {
                "id": "b783a340ede7",
                "text": "why not",
                "collapsed": false,
                "mark": null,
                "children": []
              }
            ]
          },
          {
            "id": "46c37f6d66f2",
            "text": "allow to export svg with transparent background",
            "collapsed": false,
            "mark": null,
            "children": []
          }
        ]
      },
      {
        "id": "720dbd712035",
        "text": "security",
        "collapsed": false,
        "mark": null,
        "children": [
          {
            "id": "4d87f98a1997",
            "text": "do one more audit after everything is finished",
            "collapsed": false,
            "mark": "💤",
            "children": []
          }
        ]
      },
      {
        "id": "cc3cf4dce67c",
        "text": "performance",
        "collapsed": false,
        "mark": null,
        "children": []
      },
      {
        "id": "c7fada474760",
        "text": "behavior improvements",
        "collapsed": false,
        "mark": null,
        "children": []
      },
      {
        "id": "fbccd14539f2",
        "text": "to test",
        "collapsed": false,
        "mark": null,
        "children": []
      },
      {
        "id": "8a49611a965a",
        "text": "tangential",
        "collapsed": false,
        "mark": null,
        "children": []
      }
    ]
  },
  "cut": [
    {
      "id": "3c03a940618c",
      "text": "say .desktop and xdg gets created",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "be020f2e040c",
      "text": "config",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "6c75456c3746",
          "text": "write into config which version of spoider created it",
          "collapsed": false,
          "mark": null,
          "children": [
            {
              "id": "5867e892cdca",
              "text": "this would be useful if later there is a migration\nof configs after update",
              "collapsed": false,
              "mark": null,
              "children": []
            }
          ]
        }
      ]
    },
    {
      "id": "c30185527a4c",
      "text": "some vertical lines connecting cells draw over\ncell's text, while in pyramid or bush, when\nspacing is -3, -4, or -5",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "47f016eb545f",
      "text": "cell that is taller than cousins may cover their\nconnecting lines due to smart stacking. Lines\nshall be respected and never drawn over by another\ncell. This happens in pyramid and bush",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "34c686732e94",
      "text": "make prompt with path pre-fill the whole path always",
      "collapsed": false,
      "mark": "⚠️",
      "children": []
    },
    {
      "id": "6769ca7710eb",
      "text": "make marks render in the middle of the cell\nheight. Whole cell content should get offset\ntogether, not only first line like it is now",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "5af6d4530519",
      "text": "remove layout name item from top right corner of the screen",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "9a3a76e72154",
      "text": "copy cell text with alt+6 should notify that cell\ntext waas copied and where",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "12acf1a28989",
      "text": "notification relocate down",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "3f7187228dec",
          "text": "do not start with capital letters",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "9db54fc3c3ad",
      "text": "cell editor",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "52f3c1fc72e6",
          "text": "unify code of prompt field inside the app. ^O and\nsimilar fields should have basic navigation and\nfuctions like text editor - that which we already\nmade for cells. Example: ctrl+left jump a word to\nthe left; home and end keys etc.",
          "collapsed": false,
          "mark": "✅",
          "children": []
        },
        {
          "id": "417d2e7271f6",
          "text": "consider characters like , . / \\ ' \" ` : ; ? ! # and other\nspecial ones when jumping words with ctrl+left etc.",
          "collapsed": false,
          "mark": "✅",
          "children": [
            {
              "id": "677fce39204b",
              "text": "all these are also considered when\ndeleting with alt+backspace",
              "collapsed": false,
              "mark": "✅",
              "children": []
            }
          ]
        },
        {
          "id": "76e9273d7f78",
          "text": "make undo in cells revert the whole words sequence\nof character deletions instead of returning each\ncharacter one by one - like other text editors",
          "collapsed": false,
          "mark": "✅",
          "children": []
        },
        {
          "id": "ca8a082c248a",
          "text": "make justify respect paragraphs",
          "collapsed": false,
          "mark": "✅",
          "children": [
            {
              "id": "88eb2de0ff92",
              "text": "\\n \\n",
              "collapsed": false,
              "mark": null,
              "children": [
                {
                  "id": "9a3cf051becc",
                  "text": "many new lines will shrink into two \\n",
                  "collapsed": false,
                  "mark": null,
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "11f5d76dc3de",
      "text": "set_mark prompt and save prompt does not allow paste from clipboard",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "41eb00838992",
      "text": "infinite notifications overwritten",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "9918de83547e",
      "text": "check if some code that handles rendering is not\ndoing wild calculations that would eat cpu\nunnecesarily - for example when pane moves and is\nre-rendered",
      "collapsed": false,
      "mark": "⌛",
      "children": [
        {
          "id": "a3f26bda2c1a",
          "text": "textual rerenders things, but improvemments were made",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "7255a7b354d9",
      "text": "try rewriting all rendering from scratch and better",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "b28643ce06fd",
      "text": "try it with caret as a standalone widget to see if\nwe get improved performance",
      "collapsed": false,
      "mark": "❌",
      "children": [
        {
          "id": "2f3e7735e34a",
          "text": "having screen redrawn by line ended up being\nthe best solution",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "4c0626f0700e",
      "text": "lifo view does not render beyond edge when lifo stack page reaches maxximum width",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "fcd22cd6842a",
          "text": "allow shifting of view - same as main pane",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "74c295c8235a",
      "text": "footer needs to be at the bottom of the screen when we are in ?help",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "80973c594ce8",
      "text": "allow for navigation in lifo with pgdown, pgup\netc. like we have with the main pane",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "e296ef7aaccf",
      "text": "also allow for navigation with arrows which is\npossitional, like we have on main pane, and not\nstrictly hierarchical",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "f8567bec41b1",
          "text": "difference is that items the do not have a main\nnode, however the logic is similar",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "953dfc7ac73c",
      "text": "cell streches by one when opened",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "0316e010500e",
      "text": "change: esc in cell ought to save it\nlike enter, because if user wants to\nrevert, he can ctrl+z",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "e831d4e87003",
      "text": "redo should be in the footer",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "6b9dc4d1b84d",
          "text": "after undo",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "1d06f34d78b1",
      "text": "copy text should be in footer",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "51f26f5468a2",
          "text": "give info about what happened via a\nnotification (green): Cell text copied",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "759a73bcb134",
          "text": "this creates problem when pasting on top of a cell\nwill want to paste from stack, not coppied text -\nlogical, but maybe unintuitive - but it is okay.",
          "collapsed": false,
          "mark": "💡",
          "children": []
        }
      ]
    },
    {
      "id": "730f8153dd93",
      "text": "when selecting multiple sibligs,\nselection should be totaly reversed,\nexcept the one on which cursor lays now - that one has only walls reversed like it is now. In that case we can get rid of the underline.",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "a9c54efa73c4",
      "text": "make default redo a ctrl+r",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "c2e8cb9da41c",
      "text": "invalid combination of keys for chord should anounce config error",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "dc0425bdc6df",
          "text": "such as e+r; r+alt, ctrl+alt+r",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "7117c7db71d0",
      "text": "shift select should work in prompts",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "0f947979a43c",
          "text": "this shows in footer as hint",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "759bc2f25e90",
      "text": "redo should work in prompts like undo does",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "ef6a11c2484f",
      "text": "show editor modes in debug. This reffers to places\nwhere user's cursor can be",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "ae5aad282563",
          "text": "cell edit",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "4e2685d9320a",
          "text": "in prompt",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "6e0af8047ceb",
          "text": "in stack",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "54c7369351ea",
          "text": "main pane",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "5d73eef75e9b",
          "text": "help page",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "e57470f0c9f6",
          "text": "whichever other mode there is",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "4218709522ea",
      "text": "regarding ctrl+f find:",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "646f331fc11d",
          "text": "when find is not desired anymore, esc key should\ncancel it, thus highlighted items unhighlight",
          "collapsed": false,
          "mark": "✅",
          "children": []
        },
        {
          "id": "2443f2d55816",
          "text": "after find prompt is confirmed with enter, find\ncounter stays until we escape from this mode. Find\ncounter is highligted always (yellow color - same\nas cut stack when we are in it)",
          "collapsed": false,
          "mark": "✅",
          "children": []
        },
        {
          "id": "1a40097b9dce",
          "text": "for that duration find alt+b Previous and alt+f Next apears in the footer",
          "collapsed": false,
          "mark": "✅",
          "children": []
        }
      ]
    },
    {
      "id": "1fb7934a9531",
      "text": "footer could be 2 lines tall, if items do not fit on one line",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "bf631efd3ae4",
          "text": "those two line stay equaly long, and do dnot reach\nover the bottom right special items of the footer\n(debug, config, help)",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "a8e1cd4eea83",
      "text": "minimalistic file manager for opening files",
      "collapsed": false,
      "mark": "❌",
      "children": [
        {
          "id": "e95d9343230c",
          "text": "this is bloat",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "543aafb87543",
      "text": "binds stop working when caps lock is on",
      "collapsed": false,
      "mark": "❌",
      "children": [
        {
          "id": "06d08c64152f",
          "text": "we keep this. it is like vim. Turn you caps off dude",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "6249b80d1f43",
          "text": "caps lock should be ignored when user is not writing",
          "collapsed": false,
          "mark": "❌",
          "children": []
        }
      ]
    },
    {
      "id": "666cc3cfba31",
      "text": "shift+w binds do not work. shift+alt+w still does",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "cdd3135d925e",
      "text": "allow shift+arrow to sellect also cousins",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "88e22f56777c",
      "text": "add third level headings for markdown exports",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "710dc666e8c6",
      "text": "during mermaid export, lets ignore newlines in cells, unless there are\ntwo or more in succession - in that case turn successive new lines\ninto two new lines",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "01a564085b44",
      "text": "CLI",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "aedd375142e6",
          "text": "--version",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "61d8b868cb45",
          "text": "ability to stdout an exported map instead of -o",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "cc893f986aac",
      "text": "when a cell is longer than the entire width of\npane, the cursor is not followed by the view",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "fd66a7d3ecd2",
          "text": "it is more broken in lifo",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "a63ddde50791",
          "text": "less broken in main pane",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "12750907f1fc",
      "text": "after undo in lifo stack view, focus returns on\nfirst (top) cell",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "0eb218683176",
          "text": "it should stay on (or near) the one which was undone",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "6cd2d14804a0",
          "text": "undo and redo and delete should also behave reasonably",
          "collapsed": false,
          "mark": "✅",
          "children": []
        }
      ]
    },
    {
      "id": "d41edaff16d1",
      "text": "when I open a cell and click enter again to save it, it couts as an\naction for undo, even though nothing has changed in the\ncell.",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "23f393f65769",
          "text": "An action that leaves the thing identical should\nnot count as a step for undo/redo",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "bdf5e809b235",
      "text": "whole map undo history should respect MAX_UNDO",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "88e578d32bad",
      "text": "view of lifo stack is one line too low. Top\ncell always gets clipped when lifo opens",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "cacdf68ec338",
      "text": "test conversion of svg to pdf with\nrsvg-convert",
      "collapsed": false,
      "mark": "❌",
      "children": [
        {
          "id": "04a387ce4968",
          "text": "it is bad",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "b8fbfb449287",
      "text": "make it so that when in `cut stac - find' mode firs esc leaves find and second leaves cut stack view",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "9394da63648f",
      "text": "have total cell count highlighted yellow\n(like stack count is) when we are on the main\npane",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "f81795488958",
          "text": "keep it up even if we are in find mode ->\nfind will then be a third item on the top bar",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "261ccc5671af",
          "text": "make it say \"$number cells\" - it is not total (lifo not included)",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "743649d9ef27",
      "text": "--palette coloured can be misspelled as colored (american)",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "615c5191b207",
          "text": "make both work (american is left as a silent alias)",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "ec801bc58a56",
      "text": "when saving file make it so that we check if\nthe file has been altered in the meantime\n(since we saved last time or since it was\nopened). If yes, say it and demand additional\nconfirmation before file gets overwritten.\nThis will work line nano editor does it.",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "88e2894bb6fa",
          "text": "also check the same when autosave tries to do it",
          "collapsed": false,
          "mark": null,
          "children": [
            {
              "id": "26deedc36fec",
              "text": "in that case there should be anouncement that\nthe autosave failed: file has been altered by\nanother instance; then we demand that user\nsaves it manually before closing app",
              "collapsed": false,
              "mark": null,
              "children": []
            }
          ]
        }
      ]
    },
    {
      "id": "61a774c7d460",
      "text": "when undo puts cell into stack, cursor follows it\nbut stack is closed. That makes the cursor\ndisapear from the POV if the user and creates a\nsituation where he is stuck. The bug seems to\nocure only sometimes. Perhaps only when undo is\ndone twice in a row - not sure.",
      "collapsed": false,
      "mark": "✅",
      "children": [
        {
          "id": "aee00860579d",
          "text": "desired state: whe undo or redo puts something in\nthe stack, we do not want to follow it. It cases\nwhen we want to follow it, the lifo stack must\nopen",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "17b574f088e2",
      "text": "Keep history of each cell edit\nsaved after we leave the cell",
      "collapsed": true,
      "mark": "✅",
      "children": [
        {
          "id": "c9d37ae11a1b",
          "text": "we would have to keep track of how that\nrelates to the global history and ditch it,\nif we undo from the overview",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "a7b2c0f1b6fd",
          "text": "the logic of this needs to be thought through.\nThis is how I imagine it:",
          "collapsed": false,
          "mark": null,
          "children": [
            {
              "id": "91c0d527311c",
              "text": "each cell's history is kept in memory even after we leave the cell",
              "collapsed": false,
              "mark": null,
              "children": []
            },
            {
              "id": "354a1fffc4a0",
              "text": "undoing a cell change from the global history reverts all coresponting\nsteps from the cell's history. That can be a big chunk. Redo does the same in the oposite direction",
              "collapsed": false,
              "mark": null,
              "children": []
            },
            {
              "id": "e7cd94a780af",
              "text": "so the result will be the global undo makes larger steps, while the cell's individual undo goes by smaller steps",
              "collapsed": false,
              "mark": null,
              "children": []
            }
          ]
        }
      ]
    },
    {
      "id": "93ee3942a3af",
      "text": "make a protocol for making reproducible *-pyc.pyz\narchive which will the be signed by me manually",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "eb2fd97a1d70",
      "text": "chage mindmap data format to YAML or something\nbetter, to improve readablility and maybe reduce\nfile size. JSON seems bad for both.",
      "collapsed": false,
      "mark": "❌",
      "children": [
        {
          "id": "31a38043ceca",
          "text": "no need, it works just fine",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "a341fac7f538",
      "text": "improve undo algorithm - keeping whole maps\nas a backup for each step is bad",
      "collapsed": true,
      "mark": "✅",
      "children": [
        {
          "id": "1cb078080b18",
          "text": "either compress",
          "collapsed": false,
          "mark": "✅",
          "children": [
            {
              "id": "438380be1904",
              "text": "we chose this for simplicity\n\nhistory of a big map with 200 changes takes about 1MB",
              "collapsed": false,
              "mark": null,
              "children": []
            }
          ]
        },
        {
          "id": "76882176a9d7",
          "text": "or implement diff hunks",
          "collapsed": false,
          "mark": "❌",
          "children": [
            {
              "id": "18cb6c2f5e32",
              "text": "hunks by key ID",
              "collapsed": false,
              "mark": "💡",
              "children": [
                {
                  "id": "f8b2f2dcc892",
                  "text": "better",
                  "collapsed": false,
                  "mark": null,
                  "children": []
                },
                {
                  "id": "0bff6ca77b7d",
                  "text": "still a possibility",
                  "collapsed": false,
                  "mark": null,
                  "children": []
                },
                {
                  "id": "802e54c27c7b",
                  "text": "this would be more efficient but requires new code",
                  "collapsed": false,
                  "mark": null,
                  "children": []
                }
              ]
            },
            {
              "id": "6f1fde33f174",
              "text": "hunks by line",
              "collapsed": true,
              "mark": "❌",
              "children": [
                {
                  "id": "764fb2608a9d",
                  "text": "\"Doable, but it is a second representation of the document that must never drift.\"",
                  "collapsed": false,
                  "mark": null,
                  "children": []
                },
                {
                  "id": "4cbbf96c64ec",
                  "text": "worse in some cases",
                  "collapsed": false,
                  "mark": null,
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "d9a14aecc4cd",
      "text": "serve a textual-web version for testing",
      "collapsed": true,
      "mark": "❌",
      "children": [
        {
          "id": "7f8b6d105b07",
          "text": "seems too complicated",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "e59af42930e4",
          "text": "run on server with textual-serve",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "cff927f97429",
          "text": "or ship whole app into browser which would\nneed to be compiled with textual-wasm",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "dbad2c3ee894",
      "text": "when I select multiple cells with cousins among them (not only siblings), program crashes. Fix bug",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "5ecbc9230c62",
      "text": "correct esc and enter items in footer bar in cell edit mode",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "bbf57cafb255",
      "text": "rename `debug` widget to `info`",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "5078ee72d7e2",
      "text": "fix: info widget not updating after save",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "a720169c9876",
      "text": "highlight cell better when in it",
      "collapsed": true,
      "mark": "✅",
      "children": [
        {
          "id": "c796a0e94cbf",
          "text": "current state:\ncell which we are editing will get its leftmost cell wall reversed",
          "collapsed": false,
          "mark": null,
          "children": [
            {
              "id": "293310571da6",
              "text": "not the most beautiful",
              "collapsed": false,
              "mark": null,
              "children": []
            }
          ]
        },
        {
          "id": "99a92f75886e",
          "text": "the problem is that sometimes it is not obvious\nthat we are inside a cell because the caret, which\nis small, is the only indicator - easily missed",
          "collapsed": false,
          "mark": "❓",
          "children": [
            {
              "id": "a443cd79b1e0",
              "text": "maybe solved with blinking cursor?",
              "collapsed": false,
              "mark": "💡",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "id": "6e129ecd5e24",
      "text": "make a better icon for installed spoider app",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "8ac426ddbcb9",
      "text": "allow up to 80 width of lifo stack when termianl is narrow",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "883c7edb38ca",
      "text": "improve algo for drawing cells",
      "collapsed": false,
      "mark": "✅",
      "children": []
    },
    {
      "id": "2b322eb5611d",
      "text": "add vertical layout",
      "collapsed": true,
      "mark": "✅",
      "children": [
        {
          "id": "b6b6652cf65a",
          "text": "rule: children are always bellow and a little to the right from their parent",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "ba6be234566e",
          "text": "this will end up looking like a output of `tree` command",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    },
    {
      "id": "f4b6d72700bc",
      "text": "show a little bit of LIFO stack even when we are not in it",
      "collapsed": true,
      "mark": "❌",
      "children": [
        {
          "id": "9275bddad6f7",
          "text": "only when there is enough space on the screen",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "0e94dd9354a1",
          "text": "maximum characters = about 30",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "07f98fc96cb4",
          "text": "gray color only",
          "collapsed": false,
          "mark": null,
          "children": []
        },
        {
          "id": "bb5093cd7594",
          "text": "option to turn that off in conf",
          "collapsed": false,
          "mark": null,
          "children": []
        }
      ]
    }
  ]
}
