#!/usr/bin/env bash
# Build the two downloadable archives a release ships.
#
#   scripts/build-pyz                 writes dist/spoider-<version>.pyz and -pyc.pyz
#   scripts/build-pyz -o /tmp/out     writes them somewhere other than dist/
#   PYTHON=3.14 scripts/build-pyz     chooses the interpreter the .pyc files are made with
#
# The first archive is a shiv build: it unpacks itself into ~/.shiv on first run, and starts in
# about a third of a second afterwards. The second carries the compiled .pyc files inside the zip,
# so it never writes anywhere, and starts in about the same time on the Python it was built with.
# Both carry every dependency, so a reader needs nothing but Python 3.11 or newer.
#
# Both are reproducible: the same tree builds the same bytes, so a hash printed in a release note
# can be checked. Everything that names a path or the moment of building is taken out (the install's
# own metadata), every file time is one epoch, the .pyc files validate by hash rather than by a
# timestamp, and shiv is told to write a reproducible archive.
set -euo pipefail

out=dist
python_version=${PYTHON:-3.14}
#: The one moment every file in an archive claims: 1980-01-01, the oldest a zip can hold.
epoch=${SOURCE_DATE_EPOCH:-315532800}

while [ $# -gt 0 ]; do
    case $1 in
        -o|--out) out=$2; shift 2 ;;
        -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "build-pyz: unknown argument $1" >&2; exit 2 ;;
    esac
done

root=$(git rev-parse --show-toplevel)
cd "$root"
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' pyproject.toml | head -1)
[ -n "$version" ] || { echo "build-pyz: no version in pyproject.toml" >&2; exit 1; }
command -v uv >/dev/null || { echo "build-pyz: uv is not installed" >&2; exit 1; }

# An archive is what a release hands out, so say when it is not being made from the tag it names.
tag=$(git describe --tags --exact-match HEAD 2>/dev/null || true)
if [ "$tag" != "v$version" ]; then
    echo "build-pyz: warning: HEAD is not tagged v$version (it is ${tag:-untagged}); the archives" >&2
    echo "build-pyz:          are built from the working tree as it stands." >&2
fi
if [ -n "$(git status --porcelain)" ]; then
    echo "build-pyz: warning: the working tree has changes:" >&2
    git status --short >&2
fi

mkdir -p "$out"
out=$(cd "$out" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

echo "building spoider $version with python $python_version"
uv build --wheel --out-dir "$tmp/wheels" >/dev/null 2>&1
wheel=$(ls "$tmp"/wheels/*.whl)

uv venv --python "$python_version" "$tmp/venv" >/dev/null 2>&1
# The dependency set comes from the lock, not from whatever resolves today: a hash in a release note
# is worth something only if a build made months later carries the same versions, and a resolve at
# build time quietly answers a different question each time it is asked.
uv export --frozen --no-emit-project --no-dev --output-file "$tmp/reqs.txt" >/dev/null 2>&1
uv pip install --python "$tmp/venv/bin/python" --no-deps "$wheel" >/dev/null 2>&1
uv pip install --python "$tmp/venv/bin/python" --require-hashes -r "$tmp/reqs.txt" >/dev/null 2>&1
site=$("$tmp/venv/bin/python" -c "import sysconfig; print(sysconfig.get_path('purelib'))")

# The install's own notes name the temp directory it came from and when it was written, so a build
# that kept them could never come out the same twice.
# RECORD goes too: it lists the console script in the venv's bin and the install's own notes, and
# both carry the temp path, so keeping it would keep the build's difference.
find "$site" -maxdepth 2 \
    \( -name direct_url.json -o -name uv_build.json -o -name uv_cache.json -o -name RECORD \) -delete
find "$site" -exec touch -h -d "@$epoch" {} +

# 1. The shiv archive: self-extracting, and the shebang is the reader's python, not this one.
uv run --with shiv --python "$tmp/venv/bin/python" shiv -c spoider --site-packages "$site" \
    --reproducible --build-id "spoider-$version" -p "/usr/bin/env python3" \
    -o "$out/spoider-$version.pyz" >/dev/null 2>&1

# 2. The archive that carries its compiled code, so zipimport never has to compile anything.
rm -rf "$tmp/app"
mkdir -p "$tmp/app"
cp -r "$site"/* "$tmp/app/"
find "$tmp/app" -name __pycache__ -type d -prune -exec rm -rf {} +
rm -rf "$tmp/app/bin"
printf 'from spoider.app import main\n\nmain()\n' > "$tmp/app/__main__.py"
"$tmp/venv/bin/python" -c "import compileall, py_compile; compileall.compile_dir('$tmp/app', quiet=2, legacy=True, force=True, workers=8, stripdir='$tmp/app', invalidation_mode=py_compile.PycInvalidationMode.CHECKED_HASH)"
find "$tmp/app" -exec touch -h -d "@$epoch" {} +
"$tmp/venv/bin/python" -m zipapp "$tmp/app" -p "/usr/bin/env python3" -c -o "$out/spoider-$version-pyc.pyz"
chmod 755 "$out/spoider-$version.pyz" "$out/spoider-$version-pyc.pyz"

# Every archive has to answer as the version it is named for, or it is not shippable.
for file in "$out/spoider-$version.pyz" "$out/spoider-$version-pyc.pyz"; do
    said=$("$file" --version)
    if [ "$said" != "spoider $version" ]; then
        echo "build-pyz: $file answered '$said', not 'spoider $version'" >&2
        exit 1
    fi
done

echo
du -h "$out/spoider-$version.pyz" "$out/spoider-$version-pyc.pyz" | sed 's/\t/  /'
# The file that gets signed: written beside the archives, so a build always leaves something to
# sign, and printed, so the numbers are in the log of the run that made them.
(cd "$out" && sha256sum "spoider-$version.pyz" "spoider-$version-pyc.pyz" | tee SHA256SUMS)
