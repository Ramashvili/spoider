#!/usr/bin/env bash
# Build the archive a release ships.
#
#   scripts/build-pyz                 writes dist/spoider-<version>-pyc.pyz
#   scripts/build-pyz -o /tmp/out     writes it somewhere other than dist/
#   PYTHON=3.14.10 scripts/build-pyz  chooses the interpreter the .pyc files are made with
#
# The archive is a zipapp carrying every dependency and the compiled form of every module, so
# zipimport compiles nothing at startup and nothing is written to disk when it runs. A reader needs
# Python 3.11 or newer and nothing else.
#
# The same tree builds the same bytes, so a hash in a release note can be checked by anyone who
# builds the tag: everything that names a path or the moment of building is taken out (the install's
# own metadata), every file time is one moment in UTC, file modes are fixed, the .pyc files validate
# by hash rather than by a timestamp, and the interpreter is uv's own build of a pinned patch, which
# carries its own zlib inside it.
set -euo pipefail

# A zip entry records a local time, so a build must not depend on the builder's zone: a runner in UTC
# and a machine in CET wrote the same files with timestamps an hour apart, and every entry differed.
export TZ=UTC

out=dist
# the exact patch, not the minor: uv's own build of CPython carries its own zlib, so pinning it
# keeps the compression library out of the differences between machines
python_version=${PYTHON:-3.14.10}
#: The one moment every file in the archive claims: 1980-01-01, the oldest a zip can hold.
epoch=${SOURCE_DATE_EPOCH:-315532800}

while [ $# -gt 0 ]; do
    case $1 in
        -o|--out) out=$2; shift 2 ;;
        -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "build-pyz: unknown argument $1" >&2; exit 2 ;;
    esac
done

root=$(git rev-parse --show-toplevel)
cd "$root"
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' pyproject.toml | head -1)
[ -n "$version" ] || { echo "build-pyz: no version in pyproject.toml" >&2; exit 1; }
command -v uv >/dev/null || { echo "build-pyz: uv is not installed" >&2; exit 1; }

# An archive is what a release hands out, so say when it is not being made from the tag it names.
tag=$(git describe --tags --exact-match HEAD 2>/dev/null || true)
if [ "$tag" != "v$version" ]; then
    echo "build-pyz: warning: HEAD is not tagged v$version (it is ${tag:-untagged}); the archive" >&2
    echo "build-pyz:          is built from the working tree as it stands." >&2
fi
if [ -n "$(git status --porcelain)" ]; then
    echo "build-pyz: warning: the working tree has changes:" >&2
    git status --short >&2
fi

mkdir -p "$out"
out=$(cd "$out" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

echo "building spoider $version with python $python_version"
uv build --wheel --out-dir "$tmp/wheels" >/dev/null 2>&1
wheel=$(ls "$tmp"/wheels/*.whl)

uv python install "$python_version" >/dev/null 2>&1
uv venv --python-preference only-managed --python "$python_version" "$tmp/venv" >/dev/null 2>&1
# The dependency set comes from the lock, not from whatever resolves today: a hash in a release note
# is worth something only if a build made months later carries the same versions, and a resolve at
# build time quietly answers a different question each time it is asked.
uv export --frozen --no-emit-project --no-dev --output-file "$tmp/reqs.txt" >/dev/null 2>&1
uv pip install --python "$tmp/venv/bin/python" --no-deps "$wheel" >/dev/null 2>&1
uv pip install --python "$tmp/venv/bin/python" --require-hashes -r "$tmp/reqs.txt" >/dev/null 2>&1
site=$("$tmp/venv/bin/python" -c "import sysconfig; print(sysconfig.get_path('purelib'))")

# The install's own notes name the temp directory it came from and when it was written, so a build
# that kept them could never come out the same twice. RECORD goes too: it lists the console script in
# the venv's bin and the install's notes, and both carry the temp path.
find "$site" -maxdepth 2 \
    \( -name direct_url.json -o -name uv_build.json -o -name uv_cache.json -o -name RECORD \) -delete
find "$site" -exec touch -h -d "@$epoch" {} +
# Modes travel into the archive, so a build must not remember the builder's umask: 0755 for the
# directories and 0644 for the files, whoever ran it.
find "$site" -type d -exec chmod 755 {} +
find "$site" -type f -exec chmod 644 {} +

# The staging tree: the installed packages, the entry point, and the compiled form of every module in
# the older layout, module.pyc beside module.py, which is the one zipimport looks for inside a zip.
rm -rf "$tmp/app"
cp -r "$site" "$tmp/app"
find "$tmp/app" -name __pycache__ -type d -prune -exec rm -rf {} +
rm -rf "$tmp/app/bin"
printf 'from spoider.app import main\n\nmain()\n' > "$tmp/app/__main__.py"
# A hash in the .pyc header rather than a file time, or two builds would differ in every header.
"$tmp/venv/bin/python" -c "import compileall, py_compile; compileall.compile_dir('$tmp/app', quiet=2, legacy=True, force=True, workers=8, stripdir='$tmp/app', invalidation_mode=py_compile.PycInvalidationMode.CHECKED_HASH)"
find "$tmp/app" -exec touch -h -d "@$epoch" {} +
find "$tmp/app" -type d -exec chmod 755 {} +
find "$tmp/app" -type f -exec chmod 644 {} +

archive="$out/spoider-$version-pyc.pyz"
"$tmp/venv/bin/python" -m zipapp "$tmp/app" -p "/usr/bin/env python3" -c -o "$archive"
chmod 755 "$archive"

# An archive that does not answer as the version it is named for is not shippable.
said=$("$archive" --version)
if [ "$said" != "spoider $version" ]; then
    echo "build-pyz: $archive answered '$said', not 'spoider $version'" >&2
    exit 1
fi

echo
du -h "$archive" | sed 's/\t/  /'
(cd "$out" && sha256sum "$(basename "$archive")")
